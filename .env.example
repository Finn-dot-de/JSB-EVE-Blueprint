# Vorlage für die .env - echte Werte NICHT einchecken (.env steht in .gitignore).

# --- EVE SSO / ESI ---
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_ESI_BASE_URL=https://esi.evetech.net/latest

# Diese Scopes braucht der Buybot:
#   publicData                                 Grunddaten
#   esi-characters.read_corporation_roles.v1   Titel -> Admin-Rollen
#   esi-search.search_structures.v1            Station-/Struktur-ID im Admin-Panel suchen
#   esi-universe.read_structures.v1            Namen von Upwell-Strukturen auflösen
#   esi-contracts.read_character_contracts.v1  Vertragsprüfung
#   esi-mail.send_mail.v1                      nur wenn EVE-Mail als Meldeweg genutzt wird
#   esi-assets.read_assets.v1                  eigener Injector-Bestand im Kopfbereich
EVE_SCOPES="publicData esi-characters.read_corporation_roles.v1 esi-search.search_structures.v1 esi-universe.read_structures.v1 esi-contracts.read_character_contracts.v1 esi-mail.send_mail.v1 esi-assets.read_assets.v1"

# Corporation, deren Mitglieder sich anmelden duerfen
EVE_ALLOWED_CORP=

# Wer das Admin-Panel oeffnen darf - ohne Eintrag hier kann NIEMAND die Anwendung
# einrichten. Charakternamen oder Charakter-IDs, mehrere per Komma getrennt.
# Beispiel: ADMIN_CHARACTERS=Comander-Video,90000002
ADMIN_CHARACTERS=

# --- Anwendung ---
# Callback-URL in der EVE-Anwendung: <BASE_URL>/api/auth/callback
# Ohne domäne ist es localhost:8080 die BASE_URL fürn Server und localhost:4200 für das Frontend
BASE_URL=https://deine-domain.net
APP_FRONTEND_URL=https://deine-domain.net
# Langer Zufallsstring, mindestens 32 Zeichen
APP_JWT_SECRET=
# AES-Schlüssel für die Verschlüsselung der ESI-Tokens in der Datenbank
KEYYY=

# --- Protokoll ---
# Aufbewahrungsdauer in Tagen. Das Protokoll enthält IP-Adressen; 0 schaltet das
# Löschen ab, was für einen öffentlichen Dienst nicht zu empfehlen ist.
AUDIT_RETENTION_DAYS=30
# Auch erfolgreiche Lesezugriffe mitschreiben. Aus = nur Schreibzugriffe, Fehler
# und Admin-Aktionen landen im Protokoll.
AUDIT_LOG_READS=false
