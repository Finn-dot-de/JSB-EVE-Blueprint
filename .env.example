# ==========================================
# 1. DATABASE (Single Source of Truth)
# ==========================================
DB_USER=??
DB_PASSWORD=??
DB_NAME=??

# ==========================================
# 2. EVE SSO
# ==========================================
EVE_CLIENT_ID=deine_client_id
EVE_CLIENT_SECRET=dein_client_secret
EVE_SCOPES="esi-assets.read_assets.v1 esi-universe.read_structures.v1"
EVE_ESI_BASE_URL="https://esi.evetech.net/"
EVE_ALLOWED_CORP=??
EVE_ALT_CORP_IDS=??, ??

# ==========================================
# 3. SERVER & ENCRYPTION
# ==========================================
BASE_URL=http://localhost:8080/
APP_FRONTEND_URL=http://localhost:4200
APP_JWT_SECRET=??
KEYYY=??

# ==========================================
# 4. DISCORD CONFIG
# ==========================================
DISCORD_CLIENT_ID=deine_discord_id
DISCORD_CLIENT_SECRET=dein_discord_secret
DISCORD_BOT_TOKEN=dein_bot_token
DISCORD_GUILD_ID=deine_server_id

# Flotten-Pings. Ohne Kanal-ID ist die Funktion abgeschaltet: Sie warnt beim
# Start, meldet sich am Statusendpunkt als nicht verfuegbar und antwortet auf
# einen Versuch mit 503 - statt bei jedem Klick eine Ausnahme zu werfen.
# Der Bot braucht in DIESEM Kanal: View Channel, Send Messages und
# Mention @everyone, @here and All Roles (nur fuer die lauten Pings).
DISCORD_FLEET_PING_CHANNEL_ID=
# Die VORBELEGTE Rolle der Auswahl "Rolle" - mehr nicht. Waehlbar sind seit dem
# Umbau alle unter /admin/discord verknuepften Discord-Rollen; diese Kennung ist
# nur die, die im Formular vorne steht. Sie wird dabei genauso geprueft wie eine
# Kennung aus der Anfrage: Kommt sie in den Zuordnungen nicht vor, ist sie
# wirkungslos und ein Rollen-Ping ohne eigene Angabe wird abgewiesen. Leer
# lassen ist in Ordnung - dann waehlt der FC jedes Mal selbst.
DISCORD_FLEET_PING_ROLE_ID=
# Wartezeit zwischen zwei Pings desselben Charakters. Gegen den Doppelklick, der
# sonst zwei @here ausloest. 0 schaltet sie ab.
FLEET_PING_COOLDOWN=60s