# Lombok erzeugt Getter, Setter und Konstruktoren als echten Bytecode. JaCoCo
# sieht diesen Code und wuerde ihn als ungetestet zaehlen - eine Abdeckungszahl,
# die dann mehr ueber die Menge der Entitaetsfelder aussagt als ueber die Tests.
#
# Mit dieser Einstellung markiert Lombok den erzeugten Code mit @lombok.Generated;
# JaCoCo kennt die Annotation und laesst ihn aus der Messung heraus.
lombok.addLombokGeneratedAnnotation = true

# Diese Datei ist die oberste ihrer Art im Projekt.
config.stopBubbling = true
