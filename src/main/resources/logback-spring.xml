<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging-Konfiguration des Buybots.

  Ausgabe geht bewusst nur nach stdout: im Container sammelt Docker die Zeilen ein
  ("docker compose logs"), eine eigene Logdatei im Container waere nur ein Ort mehr,
  an dem Platten volllaufen koennen.

  Jede Zeile traegt Aufruf-ID, IP und Auslöser, sofern vorhanden - damit laesst sich
  eine gemeldete Fehler-ID direkt im Log wiederfinden.
-->
<configuration>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="buybot"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Hintergrundlaeufe haben keinen Aufrufer, daher "System" als Vorgabe. -->
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS,UTC}Z %-5level [%thread] %logger{36} [req=%X{requestId:--} ip=%X{clientIp:--} actor=%X{actor:-System}] - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Eigener Code: INFO reicht im Betrieb, DEBUG nur zur Fehlersuche. -->
    <logger name="com.eve.buy.bot" level="INFO"/>

    <!-- Fremdbibliotheken ruhigstellen, damit das Protokoll lesbar bleibt. -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>

</configuration>
